# ---- Required for all environments (safe placeholder defaults keep build green) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# Razorpay (test placeholders are fine — app auto-falls back to sandbox simulator)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Stripe (optional — leave placeholder to use simulated checkout)
STRIPE_SECRET_KEY=sk_test_placeholder

# Application Base URL (set to your deployed domain on Vercel/Netlify/AWS)
NEXT_PUBLIC_APP_URL=http://localhost:3000
